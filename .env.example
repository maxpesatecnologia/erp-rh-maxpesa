# Copie este arquivo para ".env" e preencha com as chaves do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# --- Integração futura com SharePoint / Microsoft Graph API ---
# Preencher quando o registro do app no Azure AD / Microsoft Entra ID
# do tenant Microsoft 365 da Maxpesa estiver disponível.
# VITE_MS_TENANT_ID=
# VITE_MS_CLIENT_ID=
# VITE_MS_CLIENT_SECRET=   (nunca no front-end em produção; usar via backend/edge function)
# VITE_SHAREPOINT_SITE_URL=
